body {
    font-family: Arial, sans-serif;
    margin: 0;
    background: #f5f5f5;
}

header {
    background: #222;
    color: white;
    text-align: center;
    padding: 30px;
}

section {
    padding: 40px;
    margin: 20px;
    Background: white;
    border-radius: 10px
}

.project-card {
    padding: 15px;
    border: 1px solid #ddd;
    margin-top: 10px;
}

footer {
    text-align: center;
    padding: 15px;
    background: #222;
    color: white;

}

nav a {
    color: white;
    margin: 0 10px;
    text-decoration: none;
}

nav a:hover {
    color: orange
}